# server config
PORT=3000
NODE_ENV=production

# your chitkara email
OFFICIAL_EMAIL=your.email@chitkara.edu.in

# gemini api keys from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
# optional fallback key (used when primary key hits rate limit or auth errors)
GEMINI_API_KEY_FALLBACK=your_fallback_gemini_api_key_here

# rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
